# Copy to .env.local. Both values are public (safe in the browser): row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: a keyed map tile provider (defaults to OpenStreetMap)
# NEXT_PUBLIC_MAP_TILES_URL=
# NEXT_PUBLIC_MAP_ATTRIBUTION=

# Server-only Google Places key (Places API (New)); powers the property company rating. Restrict it to that API and set a daily quota.
GOOGLE_PLACES_API_KEY=
